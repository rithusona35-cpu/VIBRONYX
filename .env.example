# ==============================================================================
# MINEGUARD AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Smart India Hackathon (SIH 26008)
#
# INSTRUCTIONS:
# 1. Copy this template to a new file named .env:
#      cp .env.example .env
# 2. Fill in the values for your specific deployment environment.
# 3. All sensitive credentials must remain local and NEVER be committed to Git.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND CONFIGURATION (Vite / Netlify / Vercel)
# ==============================================================================

# URL of the deployed FastAPI YOLO backend (e.g., https://mineguard-backend.onrender.com)
# Leave empty for local development to use the local Vite proxy
VITE_API_BASE_URL=

# Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous Key (safe for browser client-side usage)
VITE_SUPABASE_ANON_KEY=


# ==============================================================================
# 2. BACKEND SERVER CONFIGURATION (FastAPI / Render / Uvicorn)
# ==============================================================================

# Server listening port (Render sets $PORT automatically, default: 8000)
PORT=

# Server host address (e.g., 0.0.0.0 for containerized/cloud hosting, 127.0.0.1 for local)
HOST=

# Allowed CORS origins: Comma-separated domains or '*' to allow all
# Example: https://mineguard-ai.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=


# ==============================================================================
# 3. YOLO INFERENCE ENGINE CONFIGURATION
# ==============================================================================

# Custom path to model weights (.onnx or .pt)
# Default fallback: models/final_sih_model_int8.onnx
MINEGUARD_MODEL_PATH=

# Inference execution device ('cpu' or 'cuda')
# Default: cpu
INFERENCE_DEVICE=

# Image resolution in pixels for letterboxed YOLO inference (default: 800)
INFERENCE_IMGSZ=

# Minimum defect detection confidence threshold (0.0 to 1.0, default: 0.25)
CONF_THRESHOLD=

# Non-Maximum Suppression (NMS) IoU threshold (0.0 to 1.0, default: 0.45)
IOU_THRESHOLD=
