# ==============================================================================
# MINEGUARD AI — DOCKER IGNORE RULES
# ==============================================================================

# Git & IDEs
.git/
.gitignore
.vscode/
.idea/

# Environment and Secrets
.env
.env.*
!.env.example

# Node.js & Frontend source
node_modules/
mineguard-dashboard/node_modules/
mineguard-dashboard/src/

# Python Virtual Environments & Cache
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large Archives & Datasets
*.zip
*.tar.gz
datasets/
experiments/
runs/
backup/
uploads/*
!uploads/.gitkeep
