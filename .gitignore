scratch/
tmp/
temp/
*.tmp
*.bak

# 5. Heavy Weights (Retain only deployment ONNX models)
*.pt
runs/
experiments/
!models/final_sih_model_int8.onnx
!models/final_sih_model.onnx

# 6. Archives & Compressed Packages
*.zip
*.tar.gz
*.rar

# 7. IDE & OS Artifacts
.vscode/*
