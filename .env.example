# ==============================================================================
# MINEGUARD AI DASHBOARD — FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Smart India Hackathon (SIH 26008)
#
# INSTRUCTIONS:
# 1. Copy this template to .env:
#      cp .env.example .env
# 2. Add your deployed backend URL and Supabase project credentials.
# 3. Leave VITE_API_BASE_URL empty when developing locally with the Vite proxy.
# ==============================================================================

# URL of the deployed FastAPI YOLO backend (e.g., https://mineguard-backend.onrender.com)
VITE_API_BASE_URL=

# Supabase Realtime Telemetry Database URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Browser-Safe Public Anonymous Key (anon role only)
VITE_SUPABASE_ANON_KEY=
