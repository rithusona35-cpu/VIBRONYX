# 1. Environment Secrets & Local Overrides (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.cert
credentials.json
service_account.json

# 2. Dependencies & Virtual Environments
venv/
.venv/
env/
ENV/

# 3. Python Bytecode & Runtime Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# 4. Server Logs & Temporary Files
logs/
*.log
uploads/*
